// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum LocationMode {
  LIVE
  LAST_KNOWN
  HIDDEN
}

enum ClientType {
  WEB
  IOS
  ANDROID
}

model User {
  id                     String       @id @default(uuid()) @db.Uuid
  email                  String       @unique
  username               String       @unique
  passwordHash           String
  nearbyDiscoveryEnabled Boolean      @default(false)
  locationMode           LocationMode @default(HIDDEN)
  emailVerifiedAt        DateTime?    @db.Timestamptz(3)
  createdAt              DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @db.Timestamptz(3)
  location               Location?
  profile                UserProfile?
  sessions               Session[]
}

model UserProfile {
  userId       String            @id @db.Uuid
  fullName     String
  photoUrl     String?
  bio          String?
  visibility   ProfileVisibility @default(PRIVATE)
  lastActiveAt DateTime?         @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  clientType    ClientType
  deviceName    String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  lastUsedAt    DateTime       @default(now()) @db.Timestamptz(3)
  expiresAt     DateTime       @db.Timestamptz(3)
  revokedAt     DateTime?      @db.Timestamptz(3)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  sessionId  String    @db.Uuid
  tokenHash  String    @unique
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  session    Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

// One latest position per user; updates replace it instead of creating history.
model Location {
  userId     String   @id @db.Uuid
  latitude   Float    @db.DoublePrecision
  longitude  Float    @db.DoublePrecision
  recordedAt DateTime @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)
  // Expiry must also be checked when reading; this field does not delete rows.
  expiresAt  DateTime @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
